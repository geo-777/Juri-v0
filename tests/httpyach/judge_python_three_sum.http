      "expected_output": "-1\n"
    },
    {
      "input": "7\n-2 0 1 1 2 -1 -4\n0\n",
      "expected_output": "0 1 2\n"
    },
    {
      "input": "6\n0 0 0 0 0 0\n0\n",
      "expected_output": "0 1 2\n"
